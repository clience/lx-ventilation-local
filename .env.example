# Host name the ventilator uses for DPS and IoT Hub. It must resolve (public DNS
# or your router's local DNS) to the machine running docker compose, port 8883.
EMU_HUB_HOST=vent.example.com

# SmartThings virtual device id printed by smartthings/setup.sh
ST_DEVICE_ID=00000000-0000-0000-0000-000000000000

# OAuth client id that issued the refresh token in data/st_refresh.txt
# (see README "토큰 넣기"). Without it the bridge cannot refresh an expired token.
ST_CLIENT_ID=

# Optional tuning
CMD_POLL=1
TELE_EVERY=10
