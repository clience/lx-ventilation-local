EMU_HUB_HOST=vent.example.com
# Set these to the owner of data/, .edge-secrets/, and edge-state/ (id -u / id -g).
LXVENT_UID=1000
LXVENT_GID=1000
LXVENT_PORT=18765
LXVENT_DEVICE_ID=lxvent-main
# Enable only after stopping every legacy cmd.json writer.
LXVENT_ENABLE_COMMANDS=false
# Optional Telegram alerts, disabled by default.
LXVENT_ALERT_SEND=false
TG_CHAT_ID=
